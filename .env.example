# Copy this file to `.env` and fill in your own values.

# Backend URL used by the sync service.
VITE_API_BASE_URL=http://localhost:4000/api

# Firebase Web app config (Firebase console -> Project settings -> General ->
# Your apps -> Web app). Required for "Đăng nhập bằng Google".
# See README.md "Cấu hình đăng nhập Google (Firebase)".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
